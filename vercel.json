{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "npm --prefix web ci",
  "buildCommand": "npm --prefix web run build",
  "outputDirectory": "web/dist",
  "functions": {
    "api/index.py": {
      "maxDuration": 120,
      "includeFiles": "{src/policyshock/**,config/**,data/snapshots/**,METHODOLOGY.md}",
      "excludeFiles": "{.venv/**,web/**,tests/**,design/**,docs/**,scripts/**,pages/**,data/cache/**,.git/**,.pytest_cache/**,**/__pycache__/**}"
    }
  },
  "rewrites": [
    {"source": "/api/:path*", "destination": "/api/index"},
    {"source": "/((?!api/|assets/|.*\\.[^/]+$).*)", "destination": "/index.html"}
  ],
  "headers": [
    {"source": "/api/:path*", "headers": [{"key": "Cache-Control", "value": "no-store"}]},
    {"source": "/assets/:path*", "headers": [{"key": "Cache-Control", "value": "public, max-age=31536000, immutable"}]}
  ]
}
