      "hideRanking": false,
      "color": "#000000",
      "description": "For an astounding 13th straight year, Apple claims the top spot in Fortune\u2019s annual ranking of corporate reputation, based on a survey of almost 3,800 executives, directors, and analysts.",
      "permalink": "https://fortune.com/ranking/worlds-most-admired-companies/2020/",
      "rank": null,
      "slug": "worlds-most-admired-companies",
      "title": "World's Most Admired Companies",
